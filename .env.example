# Vorlage. Echte Werte gehören in .env — die ist nicht versioniert.
# Kopieren:  copy .env.example .env

# OpenAI API-Key für die Sprachsynthese der Erzählerstimme.
# Wird AUSSCHLIESSLICH zur Bauzeit gebraucht (audio/narration.py backt mp3s).
# Die fertige Präsentation läuft offline und ohne Key.
OPENAI_API_KEY=sk-...

# TTS-Modell. Ohne diese Zeile fragt narration.py die verfügbaren Modelle ab
# und nimmt gpt-4o-mini-tts. Empfohlen ist aber ein datierter Snapshot: die
# mp3s werden einmal gebacken, und ein Snapshot garantiert denselben
# Stimmcharakter, falls später einzelne Beats nachgebacken werden.
# Verfügbare Modelle zeigen:  python audio/narration.py --models
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15

# Stimmen. Erzähler und Zitatstimme getrennt, damit die überlieferten Worte
# in Beat 5 hörbar von der Erzählung abgesetzt sind.
# Proben erzeugen:  python audio/narration.py --audition
# OPENAI_TTS_VOICE_NARRATOR=onyx
# OPENAI_TTS_VOICE_QUOTE=ballad
