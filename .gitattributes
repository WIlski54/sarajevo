# Zeilenenden ueberall auf LF - im Repository UND im Arbeitsverzeichnis.
# Verhindert Diff-Rauschen zwischen Editoren und haelt die von Blender
# ausgefuehrten Python-Skripte konsistent.
* text=auto eol=lf

# Ausnahme: Batch-Dateien brauchen CRLF. cmd.exe vertraegt LF meistens,
# stolpert aber bei Labels und mehrzeiligen Bloecken - und diese Datei ist
# der Doppelklick-Einstieg fuer den Unterricht. Kein Ort fuer "meistens".
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien nie anfassen
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.glb binary
*.blend binary
